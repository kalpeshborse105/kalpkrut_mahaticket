# MahaTicket Flutter client env (PUBLIC KEYS ONLY)
# Copy to `.env.client` for local builds. Never put service-role, Razorpay secret,
# SMTP passwords, TICKET_SECRET, or ADMIN_PASSWORD in Flutter assets.

NEXT_PUBLIC_APP_NAME="MahaTicket"
NEXT_PUBLIC_DEFAULT_CITY="Pune"

# Authoritative TicketGhar Next.js API (payments / PDF / email)
# Prefer production host for device testing. Localhost is remapped by EnvConfig.
APP_URL="https://mahaticket.kalpkrutinfotech.com"
NEXT_PUBLIC_API_BASE="https://mahaticket.kalpkrutinfotech.com"

# Supabase (anon / publishable key only)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Razorpay public key ID only (secret stays on the Next.js server)
RAZORPAY_KEY_ID="rzp_test_yourKeyId"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_yourKeyId"
