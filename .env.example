# MahaTicket Environment Configuration Template
# DO NOT commit actual secrets to version control.
# For local Flutter development, copy this file to .env and fill in required values.
# For Vercel Web deployments, set these in Vercel Project Environment Variables.

# Public / Client-Safe Configuration
NEXT_PUBLIC_APP_NAME="MahaTicket"
NEXT_PUBLIC_DEFAULT_CITY="Pune"
APP_URL="https://mahaticket.vercel.app"

# Supabase Client Configuration (Public Anon Key only)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Razorpay Client Configuration (Public Key ID only)
RAZORPAY_KEY_ID="rzp_test_yourKeyId"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_yourKeyId"
